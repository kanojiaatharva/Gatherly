# ==============================================================================
# Gatherly Environment Configuration Example
# Copy to .env for local overrides; never commit secrets or production credentials
# ==============================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Backend Runtime & Port
# Render assigns the HTTP listening port via PORT
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Security & Secrets
# Generate a cryptographically strong random secret for production (min 256 bits)
JWT_SECRET=replace_with_a_secure_random_base64_string_minimum_32_characters
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
AUTH_RATE_LIMIT_PER_MINUTE=60

# Database Configuration (MySQL in production / H2 fallback when SPRING_PROFILES_ACTIVE=local)
SPRING_DATASOURCE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gatherly
DB_USERNAME=gatherly_app
DB_PASSWORD=replace_me

# GenAI Provider Settings
# AI_PROVIDER options: 'mock' (offline rule-based mock) or 'openai' (live OpenAI API)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=25
AI_RATE_LIMIT_PER_MINUTE=15
